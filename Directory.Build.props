<Project>
  <!-- 本机 .NET 10 SDK 缺少 WorkloadAutoImportPropsLocator 目录（MSB4276），
       纯 Windows 桌面工程不需要移动/AOT workload，全局关闭解析器。 -->
  <PropertyGroup>
    <MSBuildEnableWorkloadResolver>false</MSBuildEnableWorkloadResolver>
  </PropertyGroup>

  <!-- === 构建体积优化：统一输出目录 ===
       所有项目输出到根目录 artifacts/ 下，避免每个 bin/ 中重复复制依赖 DLL。
       预估可减少 30-50% 的 C# 构建产物体积。 -->
  <PropertyGroup>
    <OutputPath>$(MSBuildThisFileDirectory)artifacts\bin\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)artifacts\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    
    <!-- Debug 用 portable PDB，体积更小 -->
    <DebugType Condition="'$(Configuration)'=='Debug'">portable</DebugType>
    
    <!-- Debug 不生成 XML 文档文件 -->
    <GenerateDocumentationFile Condition="'$(Configuration)'=='Debug'">false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Release 发布优化 -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
